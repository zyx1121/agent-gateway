# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to this bot
# Get yours by messaging @userinfobot
ALLOWED_USER_IDS=

# Display name for this agent (shown in /start banner and boot logs).
# The agent's actual personality lives in <CLAUDE_WORKSPACE>/CLAUDE.md.
AGENT_NAME=agent

# Path to claude binary
CLAUDE_BIN=/home/user/.local/bin/claude

# Unix socket path for daemon ↔ channel IPC.
# Default: /run/outpost.sock if writable, else $HOME/outpost.sock.
# OUTPOST_SOCK=/run/outpost.sock

# Workspace claude runs in. .mcp.json and .claude/settings.local.json
# get seeded here on boot; CLAUDE.md placed here drives the agent.
# Default: $HOME/outpost-data
# CLAUDE_WORKSPACE=/home/user/outpost-data

# If set, mirror claude's raw PTY output to stderr (debugging the dialog
# auto-dismiss / supervisor startup). Off by default — pm2 err.log stays
# readable.
# OUTPOST_PTY_LOG=1
